# Non-secret SSRF allowlist used by the Vercel HTTPS gateway.
# Set the real values in Vercel Project Settings > Environment Variables.
STARNET_ALLOWED_SERVICE_ORIGINS=http://127.0.0.1:5080
STARNET_ALLOW_INSECURE_LOCALHOST=true

# The service access key is deliberately NOT a Vercel environment variable.
# For manual prototype runs, the user enters it in the UI and it stays in tab memory.
