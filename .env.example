# Non-secret SSRF allowlist used by the Vercel FTP gateway.
# Set the real values in Vercel Project Settings > Environment Variables.
STARNET_ALLOWED_FTP_HOSTS=127.0.0.1,localhost
STARNET_ALLOWED_FTP_PORTS=2121

# FTP username/password are deliberately NOT environment variables.
# For manual prototype runs, the user enters a dedicated restricted account in the UI.
