{
  "name": "btm-topographic-adjustment-mockup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BTM Topographic Adjustment processing — interactive mock-up",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "TZ=UTC vitest run",
    "test:python": "PYTHONPATH=packages/python/topographic-adjustment-core/src python -m unittest discover -s packages/python/topographic-adjustment-core/tests -v && PYTHONPATH=packages/python/topographic-adjustment-core/src python -m unittest discover -s packages/lambdas/topographic-adjustment/tests -v",
    "test:all": "npm run test && npm run test:python",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "convert:ats34": "node scripts/convert-ats34.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@hookform/resolvers": "^3.9.0",
    "@mui/material": "^5.16.7",
    "@tanstack/react-query": "^5.56.2",
    "i18next": "^23.15.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.1",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.47.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "jsdom": "^25.0.1",
    "msw": "^2.4.9",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "xlsx": "^0.18.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
