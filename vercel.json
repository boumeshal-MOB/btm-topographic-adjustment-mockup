{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/starnet-service.ts": {
      "maxDuration": 60
    }
  },
  "env": {
    "STARNET_ALLOW_TRYCLOUDFLARE_PILOT": "true"
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
